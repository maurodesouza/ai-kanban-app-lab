{
    "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
    "files": {
        "includes": [
            "**",
            "!**/routeTree.gen.ts",
            "!**/node_modules",
            "!**/dist"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
