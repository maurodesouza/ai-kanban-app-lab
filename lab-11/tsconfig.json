{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "types": ["vite/client", "node"],
        "paths": {
            "#/*": ["./src/*"],
            "@/*": ["./src/*"]
        },
        "allowImportingTsExtensions": true
    },
    "include": ["src", "*.ts"]
}
