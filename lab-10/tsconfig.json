{
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules", "dist", ".output"],
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "types": ["vite/client", "node"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "#/*": ["./src/*"],
            "@/*": ["./src/*"]
        }
    }
}
